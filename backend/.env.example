# MemoryVerse AI — Environment Variables
# Copy this to .env and fill in real values

# === LLM (Google AI Studio Free Tier) ===
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# === File Storage (Supabase Storage / Local fallback) ===
# Set to 'supabase' for Supabase Storage, or 'local' for offline local dev
STORAGE_TYPE=supabase
UPLOAD_DIR=./uploads

# Supabase Storage Credentials (1GB Free tier)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=memoryverse-files

# === Vector Database (Qdrant Cloud Free Tier default) ===
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# === Knowledge Graph (Neo4j AuraDB Free Tier default) ===
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=de212cc7
NEO4J_PASSWORD=your-neo4j-auradb-password

# === Tesseract OCR ===
# Windows: Install from https://github.com/UB-Mannheim/tesseract/wiki
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
